# Copy to .env, then set your private access key. Never commit .env.
AVIATIONSTACK_API_KEY=replace_with_your_access_key
AVIATIONSTACK_URL=https://api.aviationstack.com/v1/flights
AVIATIONSTACK_DEP_IATA=JFK
AVIATIONSTACK_LIMIT=25
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=flight-realtime
POLL_INTERVAL_SECONDS=43200
# Optional if the actual batch compose network differs:
# AERO_BATCH_NETWORK=batch-layer_default
